DATABASE_URL=postgresql+asyncpg://news_agent:changeme@localhost:5432/ai_news

# LLM
ANTHROPIC_API_KEY=
# NOTE: the embedding model's output dimension must match vector(N) in schema.sql
# and EMBEDDING_DIM in app/models.py (currently 1536). voyage-3 emits 1024.
EMBEDDING_MODEL=voyage-3
LLM_MODEL=claude-sonnet-4-6

# Pipeline tuning
DAILY_LLM_BUDGET_USD=2.00
DEDUP_SIMILARITY_THRESHOLD=0.90
DEDUP_LOOKBACK_HOURS=48

# App
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API; * is dev-only.
CORS_ALLOW_ORIGINS=*
